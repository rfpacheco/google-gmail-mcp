{
  "name": "google-gmail-mcp",
  "version": "1.0.0",
  "description": "Gmail MCP Server and Sorting/Filtering Architecture",
  "type": "module",
  "main": "dist/sorting-and-filtering/index.js",
  "bin": {
    "google-gmail-mcp": "dist/mcp/hybrid-server.js"
  },
  "files": [
